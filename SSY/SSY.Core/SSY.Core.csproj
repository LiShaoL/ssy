	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="AlibabaCloud.SDK.Dysmsapi20170525" Version="4.2.0" />
		<PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
		<PackageReference Include="Furion.Extras.Authentication.JwtBearer" Version="4.9.7.210" />
		<PackageReference Include="Furion.Extras.ObjectMapper.Mapster" Version="4.9.7.210" />
		<PackageReference Include="Furion.Pure" Version="4.9.7.210" />
		<PackageReference Include="IP2Region.Net" Version="3.0.0" />
		<PackageReference Include="Lazy.Captcha.Core" Version="2.2.2" />
		<PackageReference Include="NewLife.Redis" Version="6.0.2025.101" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.207" />
		<PackageReference Include="UAParser" Version="3.1.47" />

		<PackageReference Include="Yitter.IdGenerator" Version="1.0.14" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />

	</ItemGroup>

	<ItemGroup>
		<None Update="Core.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Core.Production.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>